{
  "name": "seata-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node build/copyDesigner.cjs && vue-tsc && vite build && node build/copy-dist.cjs",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts,.tsx",
    "lint:fix": "eslint . --ext .vue,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,scss,css,json}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "dayjs": "^1.11.20",
    "element-plus": "^2.9.7",
    "pinia": "^2.3.1",
    "qs": "^6.15.1",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.3",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/qs": "^6.15.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "sass": "^1.87.0",
    "typescript": "^5.8.3",
    "unplugin-auto-import": "^19.1.2",
    "unplugin-vue-components": "^28.5.0",
    "vite": "^6.3.3",
    "vue-tsc": "^2.2.10"
  },
  "lint-staged": {
    "*.{vue,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,json}": [
      "prettier --write"
    ]
  }
}
