<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.apache.seata</groupId>
        <artifactId>seata-parent</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>seata-distribution</artifactId>
    <packaging>pom</packaging>
    <name>seata-distribution ${project.version}</name>
    <description>distribution for Seata built with Maven</description>

    <profiles>
        <profile>
            <id>release-seata</id>
            <properties>
                <maven.git-commit-id.skip>false</maven.git-commit-id.skip>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.apache.seata</groupId>
                    <artifactId>seata-server</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>org.apache.seata</groupId>
                    <artifactId>seata-namingserver</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>org.apache.seata</groupId>
                    <artifactId>apm-seata-skywalking-plugin</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
            <build>
                <finalName>apache-seata</finalName>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>${maven-antrun-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>aggregate-binary-license-and-notice</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <!-- Split on semantic section markers instead of line
                                             numbers, so component files can grow independently. -->
                                        <concat destfile="${project.build.directory}/LICENSE-server-common.tmp"
                                                encoding="UTF-8" fixlastline="true">
                                            <file file="${project.basedir}/LICENSE-server"/>
                                            <filterchain>
                                                <tokenfilter>
                                                    <filetokenizer/>
                                                    <replaceregex flags="s"
                                                                  pattern="(?:\r?\n)+=+\r?\nSeata Subcomponents:.*\z"
                                                                  replace=""/>
                                                </tokenfilter>
                                            </filterchain>
                                        </concat>
                                        <concat destfile="${project.build.directory}/LICENSE-namingserver-common.tmp"
                                                encoding="UTF-8" fixlastline="true">
                                            <file file="${project.basedir}/LICENSE-namingserver"/>
                                            <filterchain>
                                                <tokenfilter>
                                                    <filetokenizer/>
                                                    <replaceregex flags="s"
                                                                  pattern="(?:\r?\n)+=+\r?\nSeata Subcomponents:.*\z"
                                                                  replace=""/>
                                                </tokenfilter>
                                            </filterchain>
                                        </concat>
                                        <condition property="license.common.headers.match">
                                            <filesmatch file1="${project.build.directory}/LICENSE-server-common.tmp"
                                                        file2="${project.build.directory}/LICENSE-namingserver-common.tmp"/>
                                        </condition>
                                        <fail unless="license.common.headers.match"
                                              message="LICENSE-server and LICENSE-namingserver must have identical common license text"/>

                                        <!-- Keep the common Apache License text once, then
                                             retain component ownership for dependency terms. -->
                                        <copy file="${project.build.directory}/LICENSE-server-common.tmp"
                                              tofile="${project.build.directory}/LICENSE" overwrite="true"/>
                                        <echo file="${project.build.directory}/LICENSE" append="true" message=""/>
                                        <echo file="${project.build.directory}/LICENSE" append="true" message=""/>
                                        <echo file="${project.build.directory}/LICENSE" append="true"
                                              encoding="UTF-8"><![CDATA[
Component: seata-server

]]></echo>
                                        <echo file="${project.build.directory}/LICENSE" append="true" message=""/>
                                        <concat destfile="${project.build.directory}/LICENSE" append="true"
                                                encoding="UTF-8" fixlastline="true">
                                            <file file="${project.basedir}/LICENSE-server"/>
                                            <filterchain>
                                                <tokenfilter>
                                                    <filetokenizer/>
                                                    <replaceregex flags="s"
                                                                  pattern="\A.*?(?==+\r?\nSeata Subcomponents:)"
                                                                  replace=""/>
                                                </tokenfilter>
                                            </filterchain>
                                        </concat>
                                        <echo file="${project.build.directory}/LICENSE" append="true" message=""/>
                                        <echo file="${project.build.directory}/LICENSE" append="true"
                                              encoding="UTF-8"><![CDATA[
Component: seata-namingserver

]]></echo>
                                        <echo file="${project.build.directory}/LICENSE" append="true" message=""/>
                                        <concat destfile="${project.build.directory}/LICENSE" append="true"
                                                encoding="UTF-8" fixlastline="true">
                                            <file file="${project.basedir}/LICENSE-namingserver"/>
                                            <filterchain>
                                                <tokenfilter>
                                                    <filetokenizer/>
                                                    <replaceregex flags="s"
                                                                  pattern="\A.*?(?==+\r?\nSeata Subcomponents:)"
                                                                  replace=""/>
                                                </tokenfilter>
                                            </filterchain>
                                        </concat>

                                        <concat destfile="${project.build.directory}/NOTICE-server-common.tmp"
                                                encoding="UTF-8" fixlastline="true">
                                            <file file="${project.basedir}/NOTICE-server"/>
                                            <filterchain>
                                                <tokenfilter>
                                                    <filetokenizer/>
                                                    <replaceregex flags="s"
                                                                  pattern="(?:\r?\n)+=+.*\z"
                                                                  replace=""/>
                                                </tokenfilter>
                                            </filterchain>
                                        </concat>
                                        <concat destfile="${project.build.directory}/NOTICE-namingserver-common.tmp"
                                                encoding="UTF-8" fixlastline="true">
                                            <file file="${project.basedir}/NOTICE-namingserver"/>
                                            <filterchain>
                                                <tokenfilter>
                                                    <filetokenizer/>
                                                    <replaceregex flags="s"
                                                                  pattern="(?:\r?\n)+=+.*\z"
                                                                  replace=""/>
                                                </tokenfilter>
                                            </filterchain>
                                        </concat>
                                        <condition property="notice.common.headers.match">
                                            <filesmatch file1="${project.build.directory}/NOTICE-server-common.tmp"
                                                        file2="${project.build.directory}/NOTICE-namingserver-common.tmp"/>
                                        </condition>
                                        <fail unless="notice.common.headers.match"
                                              message="NOTICE-server and NOTICE-namingserver must have identical project notice header"/>

                                        <!-- The project NOTICE header is common. Dependency
                                             notices remain grouped by the component shipping them. -->
                                        <copy file="${project.build.directory}/NOTICE-server-common.tmp"
                                              tofile="${project.build.directory}/NOTICE" overwrite="true"/>
                                        <echo file="${project.build.directory}/NOTICE" append="true" message=""/>
                                        <echo file="${project.build.directory}/NOTICE" append="true" message=""/>
                                        <echo file="${project.build.directory}/NOTICE" append="true"
                                              encoding="UTF-8"><![CDATA[
Component: seata-server

]]></echo>
                                        <echo file="${project.build.directory}/NOTICE" append="true" message=""/>
                                        <concat destfile="${project.build.directory}/NOTICE" append="true"
                                                encoding="UTF-8" fixlastline="true">
                                            <file file="${project.basedir}/NOTICE-server"/>
                                            <filterchain>
                                                <tokenfilter>
                                                    <filetokenizer/>
                                                    <replaceregex flags="s"
                                                                  pattern="\A.*?(?==+\r?\n)"
                                                                  replace=""/>
                                                </tokenfilter>
                                            </filterchain>
                                        </concat>
                                        <echo file="${project.build.directory}/NOTICE" append="true" message=""/>
                                        <echo file="${project.build.directory}/NOTICE" append="true"
                                              encoding="UTF-8"><![CDATA[
Component: seata-namingserver

]]></echo>
                                        <echo file="${project.build.directory}/NOTICE" append="true" message=""/>
                                        <concat destfile="${project.build.directory}/NOTICE" append="true"
                                                encoding="UTF-8" fixlastline="true">
                                            <file file="${project.basedir}/NOTICE-namingserver"/>
                                            <filterchain>
                                                <tokenfilter>
                                                    <filetokenizer/>
                                                    <replaceregex flags="s"
                                                                  pattern="\A.*?(?==+\r?\n)"
                                                                  replace=""/>
                                                </tokenfilter>
                                            </filterchain>
                                        </concat>
                                        <delete>
                                            <fileset dir="${project.build.directory}" includes="*-common.tmp"/>
                                        </delete>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>${maven-assembly-plugin.version}</version>
                        <configuration>
                            <descriptors>
                                <descriptor>release-seata.xml</descriptor>
                                <descriptor>source-release.xml</descriptor>
                            </descriptors>
                        </configuration>
                        <executions>
                            <execution>
                                <id>make-assembly</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
