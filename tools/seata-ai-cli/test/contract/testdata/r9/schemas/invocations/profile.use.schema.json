{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "profile.use invocation",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "0.1"
    },
    "contract_revision": {
      "const": "R9"
    },
    "command": {
      "const": "profile.use"
    },
    "context": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "cluster": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "vgroup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [],
      "additionalProperties": false,
      "not": {
        "required": [
          "cluster",
          "vgroup"
        ]
      }
    },
    "input": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000,
          "default": 30000
        },
        "client_request_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol_version",
    "contract_revision",
    "command",
    "context",
    "input",
    "options"
  ],
  "additionalProperties": false
}
