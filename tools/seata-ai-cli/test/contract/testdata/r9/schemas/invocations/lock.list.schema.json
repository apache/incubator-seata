{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lock.list invocation",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "0.1"
    },
    "contract_revision": {
      "const": "R9"
    },
    "command": {
      "const": "lock.list"
    },
    "context": {
