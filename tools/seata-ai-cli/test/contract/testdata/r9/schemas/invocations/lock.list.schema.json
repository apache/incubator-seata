        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "cluster": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "vgroup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "profile"
      ],
      "additionalProperties": false,
      "not": {
        "required": [
          "cluster",
          "vgroup"
        ]
      }
    },
    "input": {
      "type": "object",
      "properties": {
        "xid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "branch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 19,
          "pattern": "^[1-9][0-9]*$"
        },
        "transaction_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 19,
          "pattern": "^[0-9]+$"
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "table_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "pk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "time_range": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "format": "date-time"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
