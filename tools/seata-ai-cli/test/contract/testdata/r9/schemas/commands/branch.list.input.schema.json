{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "branch.list input",
  "type": "object",
  "properties": {
    "xid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000,
      "default": 1
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 20
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 10000
    }
  },
  "required": [
    "xid"
  ],
  "additionalProperties": false
}
