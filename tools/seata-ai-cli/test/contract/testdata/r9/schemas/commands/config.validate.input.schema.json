{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "config.validate input",
  "type": "object",
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "format": {
            "type": "string",
            "enum": [
              "yaml",
              "properties"
            ]
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "maxItems": 16
    },
    "ruleset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "required": [],
  "additionalProperties": false
}
