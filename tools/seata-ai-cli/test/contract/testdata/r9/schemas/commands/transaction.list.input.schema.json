{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "transaction.list input",
  "type": "object",
  "properties": {
    "xid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "status": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "application_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "transaction_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "time_range": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000,
      "default": 1
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 20
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 10000
    }
  },
  "required": [],
  "additionalProperties": false
}
