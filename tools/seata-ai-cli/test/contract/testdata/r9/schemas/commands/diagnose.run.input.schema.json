{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "diagnose.run input",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "enum": [
        "environment",
        "transaction"
      ]
    },
    "xid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "ruleset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "scope"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "transaction"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "required": [
          "xid"
        ]
      }
    }
  ]
}
