{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "skills.export input",
  "type": "object",
  "properties": {
    "skill_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "overwrite": {
      "type": "boolean"
    }
  },
  "required": [
    "root",
    "path"
  ],
  "additionalProperties": false
}
