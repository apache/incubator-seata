    {
      "name": "seata.transport.thread-factory.worker-thread-size",
      "providers": [
        {
          "name": "handle-as",
          "parameters": {
            "target": "org.apache.seata.core.rpc.netty.NettyBaseConfig$WorkThreadMode"
          }
        }
      ]
