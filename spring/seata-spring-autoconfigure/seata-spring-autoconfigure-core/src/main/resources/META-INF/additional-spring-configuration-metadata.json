        {
          "name": "handle-as",
          "parameters": {
            "target": "org.apache.seata.config.ConfigType"
          }
        }
      ]
    },
    {
      "name": "seata.config.data-type",
      "providers": [
        {
          "name": "handle-as",
          "parameters": {
            "target": "org.apache.seata.config.processor.ConfigDataType"
          }
        }
      ]
    },
    {
      "name": "seata.registry.type",
      "providers": [
        {
          "name": "handle-as",
          "parameters": {
            "target": "org.apache.seata.discovery.registry.RegistryType"
          }
        }
      ]
    },
    {
